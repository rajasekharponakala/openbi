# OpenBI service settings (read by openbi.service)
OPENBI_HOME=/var/lib/openbi
OPENBI_BIND=127.0.0.1
OPENBI_PORT=8000
# OPENBI_SECRET=change-me             # defaults to a key generated in OPENBI_HOME
# OPENBI_DATABASE_URL=postgresql://... # defaults to SQLite in OPENBI_HOME
# OPENBI_ALLOW_DATABASE_SOURCES=1
# OPENBI_QUERY_TIMEOUT=30
